{
  "expo": {
    "name": "Küt",
    "slug": "kut",
    "version": "1.0.0",
    "orientation": "landscape",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kut.mobile",
      "buildNumber": "6",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.kut.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#0b2739",
        "foregroundImage": "./assets/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "backgroundColor": "#0b2739",
    "plugins": [
      "expo-audio",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "cover",
          "backgroundColor": "#0b2739"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#f2c14e"
        }
      ]
    ],
    "primaryColor": "#f2c14e",
    "description": "Okey taşlarıyla oynanan 16 turluk Küt oyunu — dört kişi, online.",
    "extra": {
      "eas": {
        "projectId": "0e36841b-f2d2-4c9f-a13e-8082ac00003c"
      }
    },
    "owner": "ardasalvarlilar"
  }
}
