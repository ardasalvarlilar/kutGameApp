# Sunucu
PORT=4000
NODE_ENV=development
# Virgulle ayrilmis izinli kaynaklar. Mobil uygulama icin bos birakilabilir;
# tarayici onizlemesi kullanacaksan onun adresini ekle.
CORS_KAYNAKLARI=http://localhost:8081,http://localhost:8097

# MongoDB — Atlas (bulut) onerilir, VPS'te ayrica Mongo barindirmaya gerek
# birakmiyor ve ucretsiz katman bu olcek icin yeterli. Development ve
# production AYNI cluster'i, AYNI URI'yi paylasir: hangi veritabanina
# yazilacagini asagidaki NODE_ENV belirliyor (veritabani.ts, `dbName`
# secenegi development -> "development" veritabanini seciyor). Yani buradaki
# URI'nin yolunda (path) bir veritabani adi olmasa da olur.
#
# Atlas > Database > Connect > Drivers'tan alinan baglanti dizesi:
MONGO_URI=mongodb+srv://kullanici:sifre@kume.mongodb.net/?appName=kut

# Cevrimdisi calismak istersen yerel Docker Mongo'ya da baglanabilirsin —
# bu durumda dbName yine NODE_ENV'den gelir, buradaki "/kut" yolu yok sayilir:
#   docker run -d --name kut-mongo -p 27017:27017 mongo:7
#   MONGO_URI=mongodb://127.0.0.1:27017

# Kimlik
# EN AZ 32 KARAKTER olmali. Uretimde mutlaka degistir:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_GIZLI=degistir-bunu-en-az-32-karakter-olsun-lutfen
JWT_OMRU=30d

# --- Uygulama kimligi --------------------------------------------------------
# Gizlilik / kosullar / destek sayfalari bu degerleri kullaniyor.
# App Store Connect gizlilik politikasi ve destek URL'i ISTIYOR; ikisi de
# sunucudan geliyor: /gizlilik ve /destek
UYGULAMA_ADI=Küt
ALAN_ADI=localhost:4000
DESTEK_EPOSTA=destek@alanadin.com

# --- E-posta (parola sifirlama) ----------------------------------------------
# ISTEGE BAGLI. Bos birakilirsa sunucu yine acilir; yalnizca parola sifirlama
# calismaz ve oyuncuya bunu soyleyen bir hata doner.
#
# Hostinger icin degerler (hPanel > E-postalar > E-posta hesaplari):
#   SMTP_SUNUCU=smtp.hostinger.com
#   SMTP_PORT=465          (SSL)   ya da 587 (STARTTLS, SMTP_GUVENLI=false)
#   SMTP_KULLANICI=destek@alanadin.com
#   SMTP_SIFRE=<o posta kutusunun sifresi>
SMTP_SUNUCU=
SMTP_PORT=465
SMTP_GUVENLI=true
SMTP_KULLANICI=
SMTP_SIFRE=
# Bos ise SMTP_KULLANICI kullanilir.
SMTP_GONDEREN=
