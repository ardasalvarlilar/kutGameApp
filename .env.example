# ===========================================================================
# Küt — üretim ayarları (docker compose bu dosyayı okur)
#
# Kurulum:  cp .env.example .env   sonra değerleri doldur
# Bu dosya git'e girer, `.env` GIRMEZ.
#
# NOT: Yerel geliştirmede sunucuyu Docker'sız çalıştırmak için kullanılan
# dosya AYRI: packages/server/.env (örneği packages/server/.env.example).
# ===========================================================================

# --- Alan adı ve sertifika -------------------------------------------------
# DNS'te bu adın A kaydı VPS'in IP'sine bakmalı; yoksa Let's Encrypt
# sertifika veremez ve Traefik döngüye girer.
ALAN_ADI=kut.alanadin.com

# Sertifika uyarıları bu adrese gider (süresi dolmak üzereyken).
ACME_EPOSTA=sen@alanadin.com

# --- Veritabanı ------------------------------------------------------------
# MongoDB Atlas (bulut). Development ile AYNI cluster, AYNI URI kullanılır —
# hangi veritabanına yazılacağını NODE_ENV belirliyor (yukarıda "production"),
# veritabani.ts bunu `dbName` seçeneğiyle URI'nin üzerine yazıyor. Yani bu
# değeri packages/server/.env'dekiyle birebir aynı yapıştırabilirsin.
#
# Atlas > Database > Connect > Drivers'tan alınan bağlantı dizesi; yolda
# (path) bir veritabanı adı olmasa da olur, zaten NODE_ENV=production ile
# eziliyor.
MONGO_URI=mongodb+srv://kullanici:sifre@kume.mongodb.net/?appName=kut

# --- Kimlik ----------------------------------------------------------------
# EN AZ 32 karakter. Üretimde mutlaka yenisini üret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Bu değeri değiştirirsen bütün oyuncular yeniden giriş yapar.
JWT_GIZLI=degistir-bunu-en-az-32-karakter-olmali-yoksa-sunucu-acilmaz
JWT_OMRU=30d

# --- CORS ------------------------------------------------------------------
# Mobil uygulamada tarayıcı kaynağı yok; boş bırakılabilir.
# Tarayıcıdan test edeceksen adresini virgülle ekle.
CORS_KAYNAKLARI=

# --- Uygulama kimliği ------------------------------------------------------
# Gizlilik / koşullar / destek sayfaları bu değerleri kullanıyor.
# App Store Connect gizlilik politikası ve destek URL'i İSTİYOR; ikisi de bu
# sunucudan geliyor:  https://$ALAN_ADI/gizlilik  ve  /destek
UYGULAMA_ADI=Küt
DESTEK_EPOSTA=destek@alanadin.com

# --- E-posta (parola sıfırlama) --------------------------------------------
# İSTEĞE BAĞLI ama App Store için gerekli: parolasını unutan oyuncunun tek
# çaresi yeni hesap açmak olmamalı. Boş bırakılırsa sunucu yine açılır,
# yalnızca parola sıfırlama çalışmaz.
#
# Hostinger'da: hPanel > E-postalar > E-posta hesapları
#   SMTP_SUNUCU=smtp.hostinger.com
#   SMTP_PORT=465  (SSL)  ·  587 kullanacaksan SMTP_GUVENLI=false yap
#   SMTP_KULLANICI=destek@alanadin.com
#   SMTP_SIFRE=o posta kutusunun şifresi
SMTP_SUNUCU=
SMTP_PORT=465
SMTP_GUVENLI=true
SMTP_KULLANICI=
SMTP_SIFRE=
SMTP_GONDEREN=
